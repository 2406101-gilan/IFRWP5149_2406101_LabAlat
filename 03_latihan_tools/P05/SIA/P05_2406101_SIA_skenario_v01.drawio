ingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="264" y="176" width="336" height="20" as="geometry"/></mxCell><mxCell id="c14" value="Skenario Normal" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="560" height="20" as="geometry"/></mxCell><mxCell id="c15" value="1. Dosen membuka fungsi Input Nilai Mata Kuliah" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="224" height="36" as="geometry"/></mxCell><mxCell id="c16" value="2. Sistem menampilkan daftar mata kuliah yang diampu dosen tersebut" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="264" y="216" width="336" height="36" as="geometry"/></mxCell><mxCell id="c17" value="3. Dosen memilih mata kuliah" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="224" height="36" as="geometry"/></mxCell><mxCell id="c18" value="4. Sistem menampilkan daftar mahasiswa peserta beserta kolom nilai" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="264" y="252" width="336" height="36" as="geometry"/></mxCell><mxCell id="c19" value="5. Dosen mengisi nilai setiap mahasiswa" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="224" height="36" as="geometry"/></mxCell><mxCell id="c20" value="6. Sistem memeriksa nilai berada dalam rentang yang sah" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="264" y="288" width="336" height="36" as="geometry"/></mxCell><mxCell id="c21" value="7. Dosen menyimpan nilai" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="324" width="224" height="36" as="geometry"/></mxCell><mxCell id="c22" value="8. Sistem menyimpan nilai dan menampilkan konfirmasi penyimpanan nilai" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="264" y="324" width="336" height="36" as="geometry"/></mxCell><mxCell id="c23" value="Skenario Alternative" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="560" height="20" as="geometry"/></mxCell><mxCell id="c24" value="9. Tidak ada mata kuliah yang diampu dosen tersebut (cabang dari langkah 2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="224" height="50" as="geometry"/></mxCell><mxCell id="c25" value="10. Sistem menampilkan pesan tidak ada mata kuliah yang diampu" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="264" y="380" width="336" height="50" as="geometry"/></mxCell><mxCell id="c26" value="11. Nilai di luar rentang yang sah (cabang dari langkah 6)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="224" height="36" as="geometry"/></mxCell><mxCell id="c27" value="12. Sistem menolak penyimpanan, menampilkan pesan nilai tidak sah, dan meminta dosen memperbaiki nilai" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="264" y="430" width="336" height="36" as="geometry"/></mxCell><mxCell id="c28" value="Skenario Akhir" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="466" width="224" height="50" as="geometry"/></mxCell><mxCell id="c29" value="Use case selesai jika nilai mahasiswa tersimpan; jika tidak ada mata kuliah yang diampu atau nilai di luar rentang yang sah, nilai tidak tersimpan." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="264" y="466" width="336" height="50" as="geometry"/></mxCell><mxCell id="c30" value="Keterangan: use case ini direalisasikan oleh collaboration SIA-CO01 Input Nilai Mata Kuliah. Collaboration tersebut tidak mempunyai langkah kegiatan pada tabel ini. Nilai hanya dapat diinput oleh dosen pengampu mata kuliah tersebut." style="text;html=1;whiteSpace=wrap;align=justify;verticalAlign=top;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="524" width="560" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram>
