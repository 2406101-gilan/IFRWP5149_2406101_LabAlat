spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="264" y="190" width="336" height="20" as="geometry"/></mxCell><mxCell id="c14" value="Skenario Normal" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="560" height="20" as="geometry"/></mxCell><mxCell id="c15" value="1. Admin Akademik memilih data mahasiswa yang akan dihapus" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="224" height="36" as="geometry"/></mxCell><mxCell id="c16" value="2. Sistem memeriksa mahasiswa tidak memiliki data akademik aktif" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="264" y="230" width="336" height="36" as="geometry"/></mxCell><mxCell id="c17" value="3. Admin Akademik mengonfirmasi penghapusan" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="224" height="36" as="geometry"/></mxCell><mxCell id="c18" value="4. Sistem menghapus data mahasiswa dan menampilkan konfirmasi penghapusan" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="264" y="266" width="336" height="36" as="geometry"/></mxCell><mxCell id="c19" value="Skenario Alternative" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="560" height="20" as="geometry"/></mxCell><mxCell id="c20" value="5. Mahasiswa memiliki data akademik aktif (cabang dari langkah 2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="224" height="36" as="geometry"/></mxCell><mxCell id="c21" value="6. Sistem menolak penghapusan dan menampilkan pesan mahasiswa masih memiliki data akademik aktif" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="264" y="322" width="336" height="36" as="geometry"/></mxCell><mxCell id="c22" value="Skenario Akhir" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="358" width="224" height="36" as="geometry"/></mxCell><mxCell id="c23" value="Use case selesai jika data mahasiswa terhapus; jika mahasiswa memiliki data akademik aktif, data tidak terhapus." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=1;spacingRight=4;spacingBottom=1;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="264" y="358" width="336" height="36" as="geometry"/></mxCell><mxCell id="c24" value="Keterangan: use case khusus dari SIA-UC10 Kelola Data Mahasiswa. Perilaku pembeda: data mahasiswa terhapus, dengan syarat mahasiswa tidak memiliki data akademik aktif. Langkah bersama mengikuti Tabel skenario SIA-UC10." style="text;html=1;whiteSpace=wrap;align=justify;verticalAlign=top;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="402" width="560" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram>
